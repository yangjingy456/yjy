<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>临床医学院学习资料管理</title>
    <style>
      :root {
        --bg1: #eef6ff;
        --bg2: #ecfdf5;
        --primary: #1d7af2;
        --primary-deep: #0e4fb8;
        --accent: #28b67a;
        --text: #183153;
        --muted: #66768e;
        --card: rgba(255, 255, 255, 0.8);
        --line: rgba(24, 49, 83, 0.08);
        --shadow: 0 20px 45px rgba(20, 60, 120, 0.12);
      }

      * { box-sizing: border-box; }

      html { scroll-behavior: smooth; }

      body {
        margin: 0;
        font-family: "Microsoft YaHei", "PingFang SC", Arial, sans-serif;
        background: linear-gradient(135deg, var(--bg1), var(--bg2));
        color: var(--text);
      }

      a { text-decoration: none; }

      .container {
        width: min(1200px, calc(100% - 32px));
        margin: 0 auto;
      }

      .topbar {
        position: sticky;
        top: 0;
        z-index: 30;
        backdrop-filter: blur(16px);
        background: rgba(255, 255, 255, 0.6);
        border-bottom: 1px solid rgba(17, 45, 80, 0.06);
      }

      .nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 72px;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 700;
        font-size: 1.08rem;
      }

      .brand-mark {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        color: white;
        font-weight: 900;
        background: linear-gradient(135deg, var(--primary), #6ea7ff);
        box-shadow: 0 12px 20px rgba(29, 122, 242, 0.25);
      }

      .nav-links {
        display: flex;
        gap: 24px;
        color: var(--muted);
        font-size: 0.94rem;
      }

      .nav-links a:hover { color: var(--primary); }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: none;
        border-radius: 14px;
        padding: 14px 22px;
        cursor: pointer;
        font-size: 0.98rem;
        font-weight: 700;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .btn:hover {
        transform: translateY(-2px);
      }

      .btn-primary {
        background: linear-gradient(135deg, var(--primary), #5e9eff);
        color: white;
        box-shadow: 0 14px 24px rgba(29, 122, 242, 0.18);
      }

      .btn-secondary {
        background: rgba(255, 255, 255, 0.75);
        color: var(--text);
        border: 1px solid rgba(17, 45, 80, 0.07);
      }

      .hero {
        padding: 72px 0 36px;
      }

      .hero-shell {
        display: grid;
        grid-template-columns: 1.15fr 0.85fr;
        gap: 30px;
        align-items: center;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        border-radius: 999px;
        background: rgba(29, 122, 242, 0.08);
        color: var(--primary-deep);
        font-size: 0.8rem;
        font-weight: 700;
      }

      h1 {
        margin: 18px 0 18px;
        font-size: clamp(2.3rem, 4vw, 4.2rem);
        line-height: 1.08;
        letter-spacing: -0.06em;
      }

      .subtitle {
        margin: 0 0 26px;
        max-width: 640px;
        line-height: 1.8;
        font-size: 1.04rem;
        color: var(--muted);
      }

      .cta-row {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
        margin-bottom: 28px;
      }

      .mini-stats {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
      }

      .mini-stat {
        min-width: 150px;
        padding: 14px 16px;
        background: rgba(255, 255, 255, 0.7);
        border: 1px solid var(--line);
        border-radius: 18px;
        box-shadow: 0 8px 20px rgba(18, 48, 90, 0.05);
      }

      .mini-stat strong {
        display: block;
        font-size: 1.5rem;
        margin-bottom: 4px;
      }

      .mini-stat span {
        color: var(--muted);
        font-size: 0.8rem;
      }

      .hero-panel {
        background: linear-gradient(180deg, rgba(255,255,255,0.8), rgba(255,255,255,0.68));
        border: 1px solid var(--line);
        border-radius: 28px;
        padding: 24px;
        box-shadow: var(--shadow);
      }

      .panel-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
      }

      .dot-group {
        display: flex;
        gap: 8px;
      }

      .dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
      }

      .dot.red { background: #ff6d7a; }
      .dot.yellow { background: #ffb454; }
      .dot.green { background: #3cc88f; }

      .mock-window {
        background: linear-gradient(180deg, rgba(16, 39, 78, 0.04), rgba(16, 39, 78, 0.02));
        border: 1px solid rgba(17, 45, 80, 0.06);
        border-radius: 18px;
        padding: 20px;
      }

      .mock-item {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 12px;
        align-items: center;
        padding: 14px 12px;
        border-radius: 12px;
        background: white;
        border: 1px solid rgba(17, 45, 80, 0.04);
        margin-bottom: 12px;
      }

      .mock-item:last-child { margin-bottom: 0; }

      .tag {
        display: inline-flex;
        align-items: center;
        padding: 6px 10px;
        border-radius: 999px;
        background: rgba(40, 182, 122, 0.12);
        color: #127b59;
        font-size: 0.72rem;
        font-weight: 700;
      }

      .section {
        padding: 16px 0 40px;
      }

      .cards {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 22px;
      }

      .card {
        background: rgba(255, 255, 255, 0.72);
        border: 1px solid var(--line);
        border-radius: 22px;
        padding: 28px 22px;
        box-shadow: 0 12px 28px rgba(20, 60, 120, 0.06);
      }

      .icon-box {
        width: 52px;
        height: 52px;
        border-radius: 16px;
        display: grid;
        place-items: center;
        font-size: 1.4rem;
        margin-bottom: 18px;
        background: linear-gradient(135deg, rgba(29,122,242,0.12), rgba(40,182,122,0.12));
      }

      .card h3 {
        margin: 0 0 10px;
        font-size: 1.15rem;
      }

      .card p {
        margin: 0;
        color: var(--muted);
        line-height: 1.75;
        font-size: 0.95rem;
      }

      .workspace {
        display: grid;
        grid-template-columns: 0.9fr 1.1fr;
        gap: 24px;
        margin-top: 20px;
      }

      .panel {
        background: rgba(255,255,255,0.78);
        border: 1px solid var(--line);
        border-radius: 26px;
        padding: 24px;
        box-shadow: 0 16px 32px rgba(15, 44, 96, 0.06);
      }

      .panel h2 {
        margin: 0 0 18px;
        font-size: 1.45rem;
      }

      .upload-area {
        border: 2px dashed rgba(29, 122, 242, 0.38);
        background: linear-gradient(135deg, rgba(29,122,242,0.04), rgba(40,182,122,0.04));
        border-radius: 22px;
        padding: 32px 18px;
        text-align: center;
        transition: 0.2s ease;
      }

      .upload-area.dragover {
        background: rgba(29, 122, 242, 0.09);
        transform: scale(1.01);
      }

      .upload-icon {
        font-size: 2.6rem;
        margin-bottom: 8px;
      }

      .upload-text {
        color: var(--muted);
        line-height: 1.8;
        font-size: 0.96rem;
      }

      .file-input {
        display: none;
      }

      .file-meta {
        margin-top: 18px;
        font-size: 0.85rem;
        color: var(--muted);
      }

      .analysis-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin-top: 18px;
      }

      .stat-box {
        background: linear-gradient(135deg, rgba(29,122,242,0.06), rgba(40,182,122,0.04));
        border-radius: 16px;
        padding: 16px 12px;
        border: 1px solid rgba(17,45,80,0.05);
      }

      .stat-box small {
        display: block;
        color: var(--muted);
        margin-bottom: 10px;
      }

      .stat-box strong {
        font-size: 1.65rem;
      }

      .file-list {
        margin-top: 18px;
        display: grid;
        gap: 12px;
      }

      .file-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 12px 14px;
        border-radius: 14px;
        background: rgba(245, 248, 255, 0.9);
        border: 1px solid rgba(17,45,80,0.05);
      }

      .file-name {
        font-weight: 700;
        word-break: break-all;
      }

      .file-type {
        font-size: 0.76rem;
        color: var(--muted);
      }

      .file-actions {
        display: flex;
        gap: 8px;
      }

      .chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 8px 10px;
        border-radius: 10px;
        font-size: 0.72rem;
        font-weight: 700;
        border: 1px solid transparent;
      }

      .chip.good {
        color: #0d7a4d;
        background: rgba(40, 182, 122, 0.09);
      }

      .chip.warn {
        color: #7b5b00;
        background: rgba(255, 180, 84, 0.12);
      }

      .keywords-wrap {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 14px;
      }

      .keyword {
        padding: 9px 12px;
        border-radius: 999px;
        background: rgba(29,122,242,0.08);
        color: var(--primary-deep);
        font-size: 0.8rem;
        font-weight: 700;
      }

      .suggestion-list {
        display: grid;
        gap: 12px;
        margin-top: 16px;
      }

      .suggestion {
        padding: 14px 16px;
        border-radius: 16px;
        background: rgba(236, 253, 245, 0.8);
        border: 1px solid rgba(40,182,122,0.12);
        color: #155a48;
        line-height: 1.7;
      }

      .summary-box {
        margin-top: 18px;
        background: rgba(248,250,255,0.9);
        border: 1px solid rgba(17,45,80,0.05);
        border-radius: 18px;
        padding: 18px;
      }

      .summary-box pre {
        margin: 0;
        white-space: pre-wrap;
        color: var(--text);
        line-height: 1.8;
        font-family: "Microsoft YaHei", "PingFang SC", Arial, sans-serif;
        font-size: 0.95rem;
      }

      @media (max-width: 980px) {
        .hero-shell, .workspace {
          grid-template-columns: 1fr;
        }

        .cards {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 640px) {
        .nav-links {
          display: none;
        }

        .analysis-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="container nav">
        <div class="brand">
          <div class="brand-mark">医</div>
          <span>临床医学院·学习资料平台</span>
        </div>
        <nav class="nav-links">
          <a href="#features">功能介绍</a>
          <a href="#workspace">资料上传</a>
          <a href="#analysis">智能整理</a>
        </nav>
        <a class="btn btn-primary" href="https://www.aycc.edu.cn/" target="_blank" rel="noopener noreferrer">进入官网</a>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container hero-shell">
          <div>
            <div class="eyebrow">高效学习 · 清晰整理 · 智能分析</div>
            <h1>让学习资料更有序，知识更容易复盘。</h1>
            <p class="subtitle">
              面向临床医学学习场景，支持资料上传、自动分类、关键词提取和学习整理建议，帮助医学生快速梳理重点知识与学习结构。
            </p>
            <div class="cta-row">
              <a class="btn btn-primary" href="#workspace">上传学习资料</a>
              <a class="btn btn-secondary" href="https://www.aycc.edu.cn/" target="_blank" rel="noopener noreferrer">查看官网</a>
            </div>
            <div class="mini-stats">
              <div class="mini-stat">
                <strong>3x</strong>
                <span>提升整理效率</span>
              </div>
              <div class="mini-stat">
                <strong>24h</strong>
                <span>随时随地整理</span>
              </div>
              <div class="mini-stat">
                <strong>AI</strong>
                <span>智能分析提炼</span>
              </div>
            </div>
          </div>

          <div class="hero-panel">
            <div class="panel-top">
              <div class="dot-group">
                <span class="dot red"></span>
                <span class="dot yellow"></span>
                <span class="dot green"></span>
              </div>
              <span class="tag">Learning Dashboard</span>
            </div>
            <div class="mock-window">
              <div class="mock-item">
                <div>
                  <div style="font-weight:700; margin-bottom:6px;">病理学复习要点</div>
                  <div style="color:#66768e; font-size:0.8rem;">关键词：炎症 / 组织 / 结局</div>
                </div>
                <span class="tag">重点</span>
              </div>
              <div class="mock-item">
                <div>
                  <div style="font-weight:700; margin-bottom:6px;">临床技能实践记录</div>
                  <div style="color:#66768e; font-size:0.8rem;">关键词：查体 / 诊断 / 治疗</div>
                </div>
                <span class="tag">待整理</span>
              </div>
              <div class="mock-item">
                <div>
                  <div style="font-weight:700; margin-bottom:6px;">药理学笔记</div>
                  <div style="color:#66768e; font-size:0.8rem;">关键词：药物 / 机制 / 不良反应</div>
                </div>
                <span class="tag">已归档</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="features">
        <div class="container">
          <div class="cards">
            <article class="card">
              <div class="icon-box">📤</div>
              <h3>资料上传</h3>
              <p>支持文字、笔记、课程资料等文件上传，支持拖拽导入和多文件批量处理。</p>
            </article>
            <article class="card">
              <div class="icon-box">🔍</div>
              <h3>智能分析</h3>
              <p>自动统计字数、词频、关键词和学习重点，以便快速判断资料的重点和结构层次。</p>
            </article>
            <article class="card">
              <div class="icon-box">🧠</div>
              <h3>学习整理</h3>
              <p>根据学科方向生成分类建议、整理方案和复习建议，助力高效复盘和知识沉淀。</p>
            </article>
          </div>
        </div>
      </section>

      <section class="section" id="workspace">
        <div class="container workspace">
          <div class="panel">
            <h2>上传学习资料</h2>
            <div id="uploadArea" class="upload-area" tabindex="0">
              <div class="upload-icon">📁</div>
              <div style="font-size:1.12rem; font-weight:700; margin-bottom:6px;">拖拽文件到此处</div>
              <div class="upload-text">支持 .txt / .md / .csv / .json / .pdf 等文本资料<br />点击选择文件即可上传</div>
            </div>
            <input id="fileInput" class="file-input" type="file" multiple accept=".txt,.md,.csv,.json,.pdf" />
            <div class="file-meta">
              已上传：<span id="fileCount">0</span> 个文件
            </div>
            <div id="fileList" class="file-list"></div>
          </div>

          <div class="panel" id="analysis">
            <h2>学习资料分析与整理</h2>
            <div class="analysis-grid">
              <div class="stat-box">
                <small>文件数</small>
                <strong id="statFiles">0</strong>
              </div>
              <div class="stat-box">
                <small>总字数</small>
                <strong id="statWords">0</strong>
              </div>
              <div class="stat-box">
                <small>词频</small>
                <strong id="statUnique">0</strong>
              </div>
              <div class="stat-box">
                <small>重点主题</small>
                <strong id="statThemes">0</strong>
              </div>
            </div>

            <div style="margin-top:18px;">
              <div style="font-weight:800; margin-bottom:10px;">关键词提取</div>
              <div id="keywordCloud" class="keywords-wrap"></div>
            </div>

            <div style="margin-top:22px;">
              <div style="font-weight:800; margin-bottom:10px;">整理建议</div>
              <div id="suggestionList" class="suggestion-list"></div>
            </div>

            <div class="summary-box">
              <div style="font-weight:800; margin-bottom:12px;">资料摘要</div>
              <pre id="summaryText">暂无数据，先上传学习资料后查看分析结果。</pre>
            </div>
          </div>
        </div>
      </section>
    </main>

    <script>
      const fileInput = document.getElementById('fileInput');
      const uploadArea = document.getElementById('uploadArea');
      const fileList = document.getElementById('fileList');
      const fileCount = document.getElementById('fileCount');
      const keywordCloud = document.getElementById('keywordCloud');
      const suggestionList = document.getElementById('suggestionList');
      const summaryText = document.getElementById('summaryText');
      const statFiles = document.getElementById('statFiles');
      const statWords = document.getElementById('statWords');
      const statUnique = document.getElementById('statUnique');
      const statThemes = document.getElementById('statThemes');

      const MEDICAL_TAGS = [
        '病理', '药理', '解剖', '诊断', '影像', '病历', '病例', '手术', '治疗',
        '护理', '检验', '护理', '内科', '外科', '儿科', '妇产', '药物', '查体',
        '机体', '机制', '临床', '实验', '基础', '病例分析', '病程'
      ];

      function parseTextContent(file) {
        return new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = () => {
            const result = typeof reader.result === 'string' ? reader.result : '';
            resolve({ file, content: result });
          };
          reader.onerror = () => reject(new Error('读取文件失败'));

          if (file.type.includes('pdf') || file.name.toLowerCase().endsWith('.pdf')) {
            const url = URL.createObjectURL(file);
            const script = document.createElement('script');
            script.src = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.4.168/pdf.min.mjs';
            script.type = 'module';
            script.onload = async () => {
              try {
                const pdfjsLib = window.pdfjsLib || await import('https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.4.168/pdf.min.mjs');
                const pdf = await pdfjsLib.getDocument({ data: await file.arrayBuffer() }).promise;
                let text = '';
                for (let i = 1; i <= pdf.numPages; i++) {
                  const page = await pdf.getPage(i);
                  const pageText = await page.getTextContent();
                  text += pageText.items.map(item => item.str).join(' ') + '\n';
                }
                resolve({ file, content: text });
              } catch (error) {
                resolve({ file, content: '[PDF解析失败：当前浏览器未加载PDF解析库或文件非标准文本PDF]' });
              }
            };
            script.onerror = () => resolve({ file, content: '[PDF解析失败：当前浏览器未加载PDF解析库]' });
            document.head.appendChild(script);
            return;
          }

          reader.readAsText(file, 'utf-8');
        });
      }

      function extractKeywords(text) {
        const matches = new Map();
        MEDICAL_TAGS.forEach(tag => {
          const regex = new RegExp(tag, 'gi');
          const count = (text.match(regex) || []).length;
          if (count > 0) matches.set(tag, count);
        });
        return [...matches.entries()]
          .sort((a, b) => b[1] - a[1])
          .slice(0, 8);
      }

      function computeSummary(files) {
        const summaries = files.map(item => {
          const clean = item.text
            .replace(/\s+/g, ' ')
            .replace(/[\u200B-\u200D\uFEFF]/g, '')
            .trim();
          const hint = clean.length > 0 ? clean.slice(0, 220) : '暂无内容';
          const keywords = extractKeywords(clean);
          const theme = keywords[0]?.[0] || '综合学习';
          return { ...item, clean, keywords, theme, hint };
        });

        const totalWords = summaries.reduce((sum, item) => sum + item.clean.split(/\s+/).filter(Boolean).length, 0);
        const uniqueWords = new Set(summaries.flatMap(item => item.clean.match(/[\u4e00-\u9fa5a-zA-Z0-9]+/g) || [])).size;
        const themes = new Set(summaries.map(item => item.theme));

        const summary = summaries.map((item, idx) => {
          const topic = item.keywords.length ? item.keywords.map(([k]) => k).slice(0, 3).join('、') : '综合学习';
          return `【${idx + 1}】${item.file.name}\n主题：${topic}\n整理建议：按“${item.theme}”方向梳理重点；建议将正文分为基础知识、典型病例、复习要点三部分。\n摘要：${item.hint}...\n`;
        }).join('\n');

        return {
          totalWords,
          uniqueWords,
          themeCount: themes.size,
          summary,
          summaries
        };
      }

      function renderSuggestions(summaries) {
        const suggestions = summaries.map((item, idx) => {
          const keywordText = item.keywords.length ? item.keywords.map(([k, v]) => `${k}(${v})`).join(' · ') : '综合复习';
          return {
            title: `${idx + 1}. ${item.file.name}`,
            text: `关键内容：${keywordText}；建议按“基础概念 → 重点病症 → 复习要点”三层结构进行整理，便于临床记忆和考前速查。`
          };
        });

        suggestionList.innerHTML = suggestions.length
          ? suggestions.map(item => `<div class="suggestion"><strong>${item.title}</strong><br/>${item.text}</div>`).join('')
          : '<div class="suggestion">暂无整理建议，请先上传学习资料。</div>';
      }

      function renderKeywords(summaries) {
        const allKeywords = summaries.flatMap(item => item.keywords);
        const map = new Map();
        allKeywords.forEach(([key, count]) => map.set(key, (map.get(key) || 0) + count));
        const topKeywords = [...map.entries()].sort((a, b) => b[1] - a[1]).slice(0, 10);

        keywordCloud.innerHTML = topKeywords.length
          ? topKeywords.map(([key, count]) => `<span class="keyword">${key} × ${count}</span>`).join('')
          : '<span class="keyword">等待上传资料</span>';
      }

      function renderFileList(files) {
        const items = files.map(file => `
          <div class="file-item">
            <div>
              <div class="file-name">${file.name}</div>
              <div class="file-type">${file.type || '未知类型'} • ${(file.size / 1024).toFixed(1)} KB</div>
            </div>
            <div class="file-actions">
              <span class="chip good">已分析</span>
            </div>
          </div>
        `).join('');
        fileList.innerHTML = items || '<div class="file-item"><div class="file-name">暂无上传文件</div></div>';
      }

      async function handleFiles(fileListInput) {
        const files = Array.from(fileListInput);
        if (!files.length) return;

        const parsed = await Promise.all(files.map(parseTextContent));
        const records = parsed.map(({ file, content }) => ({ file, text: content, keywords: extractKeywords(content) }));
        const metrics = computeSummary(records);

        renderFileList(records.map(item => item.file));
        renderKeywords(metrics.summaries);
        renderSuggestions(metrics.summaries);
        summaryText.textContent = metrics.summary || '暂无内容';

        fileCount.textContent = String(records.length);
        statFiles.textContent = String(records.length);
        statWords.textContent = String(metrics.totalWords);
        statUnique.textContent = String(metrics.uniqueWords);
        statThemes.textContent = String(metrics.themeCount);
      }

      uploadArea.addEventListener('click', () => fileInput.click());
      uploadArea.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          fileInput.click();
        }
      });

      ['dragenter', 'dragover'].forEach(type => {
        uploadArea.addEventListener(type, (event) => {
          event.preventDefault();
          uploadArea.classList.add('dragover');
        });
      });

      ['dragleave', 'drop'].forEach(type => {
        uploadArea.addEventListener(type, (event) => {
          event.preventDefault();
          uploadArea.classList.remove('dragover');
        });
      });

      uploadArea.addEventListener('drop', (event) => {
        const files = event.dataTransfer.files;
        if (files && files.length) {
          handleFiles(files);
        }
      });

      fileInput.addEventListener('change', (event) => {
        handleFiles(event.target.files);
        fileInput.value = '';
      });
    </script>
  </body>
</html>
